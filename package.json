{
  "name": "indie-community-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A reusable Discord bot for indie game communities: welcome cards, announcements, devlogs, build notifications and bug tickets.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "commands:deploy": "tsx --env-file=.env src/scripts/deploy-commands.ts",
    "commands:clear": "tsx --env-file=.env src/scripts/deploy-commands.ts --clear",
    "preview:card": "tsx src/scripts/preview-card.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "discord.js": "^14.27.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
