# ─────────────────────────────────────────────────────────────
#  Discord credentials
#  Get these at https://discord.com/developers/applications
# ─────────────────────────────────────────────────────────────

# Bot token (Bot tab → Reset Token). NEVER commit the real value.
DISCORD_TOKEN=

# Application ID (General Information tab → Application ID)
DISCORD_CLIENT_ID=

# Optional: when set, slash commands are registered instantly to this one
# guild instead of globally (global registration can take up to 1 hour to
# propagate). Use your test server ID during development, leave empty in
# production to register globally.
DISCORD_DEV_GUILD_ID=

# ─────────────────────────────────────────────────────────────
#  Instance — read only on a server, by docker-compose.prod.yml.
#  Irrelevant for local development. See docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────

# Names the container (bot-prod / bot-dev). Defaults to prod.
BOT_INSTANCE=prod

# The image tag this instance follows: `latest` is built from main,
# `dev` from the dev branch.
BOT_CHANNEL=latest

# Host port the container's 8080 is published on. Two instances on one
# machine need two different values.
HOST_PORT=8080

# ─────────────────────────────────────────────────────────────
#  Runtime
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Path to the SQLite file. Inside Docker this is a mounted volume.
DATABASE_PATH=./data/bot.db

# ─────────────────────────────────────────────────────────────
#  HTTP server (health checks + CI build notifications)
# ─────────────────────────────────────────────────────────────

HTTP_PORT=8080

# Shared secret that CI must send to POST /hooks/build.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it as a GitHub Actions secret named BOT_WEBHOOK_SECRET.
WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
#  Defaults for newly added guilds (all overridable per guild
#  at runtime with /config)
# ─────────────────────────────────────────────────────────────

# en | es
DEFAULT_LOCALE=en
