# Dependencies
node_modules/

# Build output
dist/

# Secrets — never commit these
.env
.env.*
# `.env-prod.env` slipped past the two rules above once: a dash is not a dot.
.env-*
*.env
!.env.example

# Runtime data (SQLite database lives here)
data/*
!data/.gitkeep

# Logs
*.log
npm-debug.log*

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Locally rendered card previews
preview/

# Exported chat/agent transcripts. These land in the repo root and are the one
# thing a `git add -A` would sweep into a public repo by accident.
/*.txt

# Stray SQLite files outside data/
*.db
*.db-shm
*.db-wal

# Cloudflare Worker: local secrets, local D1 state and build output
.dev.vars
.wrangler/
worker/.build/
